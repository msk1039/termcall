# TermCall server configuration. Copy this file to .env and set the two
# required values. The server parses this file as data; shell expressions are
# never evaluated.

# Required: the public IPv4 address advertised by the TURN relay.
TERMCALL_PUBLIC_IP=

# Required: a unique random secret of at least 32 bytes. Generate one with:
#   openssl rand -hex 32
# Never commit or send this value to clients.
TERMCALL_TURN_SECRET=

# Signaling listens on loopback so a TLS reverse proxy can expose /ws as wss://.
TERMCALL_WS_BIND=127.0.0.1
TERMCALL_WS_PORT=8080

# TURN listens on UDP and TCP. The relay range must also be allowed by the host
# firewall and the cloud security group.
TERMCALL_TURN_PORT=3478
TERMCALL_RELAY_PORT_MIN=49152
TERMCALL_RELAY_PORT_MAX=65535

TERMCALL_MAX_ROOM_SIZE=5
TERMCALL_TURN_CREDENTIAL_TTL=10m
TERMCALL_TURN_PER_USER_QUOTA=2
TERMCALL_TURN_TOTAL_QUOTA=100

# Keep private/special peer destinations blocked unless this server is for a
# deliberately trusted private-network deployment.
TERMCALL_TURN_ALLOW_PRIVATE_PEERS=false

# Optional browser-origin host patterns. Native clients do not send Origin and
# same-host browser connections are accepted automatically. Never use "*".
TERMCALL_ALLOWED_ORIGINS=

TERMCALL_MAX_CONNECTIONS_PER_IP=20
TERMCALL_MAX_CONNECTIONS=1000
TERMCALL_MAX_ROOMS=200
TERMCALL_MESSAGE_RATE=20
TERMCALL_MESSAGE_BURST=40
